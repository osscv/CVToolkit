<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- IP lookup history is privacy-sensitive, exclude from cloud backup -->
        <exclude domain="database" path="/" />
        <!-- Ad usage tracking is device-specific, exclude from backup -->
        <exclude domain="sharedpref" path="ad_usage_prefs.xml" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>